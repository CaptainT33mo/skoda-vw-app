<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Car alerts (only if the owner turns them on in My car → Owner info) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-schedule the 15-minute car check and Instant alerts after a restart / update (CarWatchBoot). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Instant car alerts (work/CarWatchService): keep the car's live feed open in the background while Car alerts
         and Instant alerts are on. connectedDevice = a network connection to the owner's car; CHANGE_NETWORK_STATE
         is that type's prerequisite. Play Console: App content → Foreground service permissions (store/play-console.md). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android Auto only: read speed / fuel level / odometer from the car's head unit (asked for in the car) -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_MILEAGE" />

    <!-- "Report a problem": find the email apps (Android 11+ only lists apps the manifest asks about) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- adjustResize: the keyboard only reaches Compose as insets (imePadding); without it (and it's an
             activity attribute, ignored on <application>) the system also pans the window, pushing the sign-in
             form under the status bar. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android Auto: both meta-data entries must sit on <application>, and the service needs a category,
             or Android Auto never lists the app. IOT = "connected device" apps (like garage doors / car status). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <receiver
            android:name=".work.CarWatchBoot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Report a problem": hands the diagnostics report to the user's email app (ui/Report.kt) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>

        <service
            android:name=".work.CarWatchService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".auto.CarPulseCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.FuelWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fuel_info" />
        </receiver>

        <receiver
            android:name=".widget.OverviewWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_overview_info" />
        </receiver>
        <receiver
            android:name=".widget.LargeWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <receiver
            android:name=".widget.LastTripWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trip_info" />
        </receiver>

        <receiver
            android:name=".widget.ParkedWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_parked_info" />
        </receiver>

    </application>

</manifest>
